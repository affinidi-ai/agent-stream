# ==============================================================================
# Agent Stream - Makefile
# ==============================================================================
SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
#
# This Makefile provides convenient shortcuts for common development tasks.
# Run `make help` for a list of available commands.
#
# Prerequisites:
# - Rust 1.95.0+ with cargo
# - Node.js and npm (for frontend)
# - Docker (for containerized deployment)
# - jq (for some storage operations)
# ==============================================================================

.PHONY: help cargo-release cargo-build run-debug run-watch run-release \
        config-certs config-debug config-debug-dev config-debug-x config-test config-release install-deps install-rust-deps verify-rust-deps verify-xml-libs fix-xml-libs install-git-hooks \
        docker-build-local docker-build-local-dev docker-rebuild-local docker-rebuild-local-dev docker-run docker-run-dev docker-shell docker-network \
        config-docker \
	test test-unit test-bins test-integration test-policies test-coverage test-junit test-rust-ci test-bdd npm-test npm-test-ci npm-build npm-build-ci npm-install npm-install-ci clippy clippy-ci fmt fmt-www-all fmt-check lint lint-bdd-gherkin npm-lint npm-lint-www-all npm-lint-ci check cargo-build-ci node-ci rust-ci node-local rust-local local audit-www-all audit-fix-www-all license-check \
        www www-dev \
        clean clean-all clear-storage clear-storage-local \
        setup-dynamodb \
        generate-cert trust-cert mediator mediator-up mediator-down \
        ngrok pre-commit pre-commit-rust pre-commit-rust-test pre-commit-node dev full-setup release \
        ui-test ui-test-headed ui-test-report \
        testkit-smoke testkit testkit-full testkit-load \
        confidence-fast confidence-full make-client

# Default target
.DEFAULT_GOAL := help

# Colors for terminal output
BLUE := $(shell printf '\033[0;34m')
GREEN := $(shell printf '\033[0;32m')
YELLOW := $(shell printf '\033[1;33m')
RED := $(shell printf '\033[0;31m')
NC := $(shell printf '\033[0m')

RUST_LLVM_MAJOR := $(shell rustc -vV 2>/dev/null | sed -n 's/^LLVM version: \([0-9][0-9]*\).*/\1/p')
RUST_LLVM_PREFIX := $(firstword $(wildcard /opt/homebrew/opt/llvm@$(RUST_LLVM_MAJOR) /usr/local/opt/llvm@$(RUST_LLVM_MAJOR)))
RUST_LLVM_DEPS := $(if $(RUST_LLVM_MAJOR),llvm@$(RUST_LLVM_MAJOR),llvm)
# libxslt is a hard requirement, not a convenience: libxmlsec1 links it, and
# without the keg-only formula present the build resolves libxslt (and through
# it a second libxml2) from the macOS system copy. Two libxml2s in one process
# segfault the moment xmlsec touches a document parsed by the other one.
#
# cyrus-sasl is required for the same reason: without a libsasl2 that
# pkg-config can find, rdkafka's sasl2-sys falls back to `-L /usr/lib`, and that
# search path makes the linker take macOS's libxml2 and libxslt from the SDK.
RUST_DEPS := sccache keith/formulae/ld64.lld protobuf xmlsec1 cmake libxml2 libxslt cyrus-sasl $(RUST_LLVM_DEPS)
BREW_PREFIX := $(shell brew --prefix 2>/dev/null)
XML_PKG_CONFIG_PATH := $(BREW_PREFIX)/opt/libxml2/lib/pkgconfig:$(BREW_PREFIX)/opt/libxslt/lib/pkgconfig:$(BREW_PREFIX)/opt/libxmlsec1/lib/pkgconfig:$(BREW_PREFIX)/opt/cyrus-sasl/lib/pkgconfig
# Every cargo build make starts links the Homebrew XML libraries, never the
# macOS system copies.
ifeq ($(shell uname -s),Darwin)
ifneq ($(BREW_PREFIX),)
ifeq ($(findstring $(XML_PKG_CONFIG_PATH),$(PKG_CONFIG_PATH)),)
export PKG_CONFIG_PATH := $(XML_PKG_CONFIG_PATH)$(if $(PKG_CONFIG_PATH),:$(PKG_CONFIG_PATH))
endif
endif
endif
CARGO_TOOLS := cargo-llvm-cov cargo-nextest cargo-audit cargo-deny cargo-watch
DEPS := jq pre-commit gitleaks
COVERAGE_THRESHOLD ?= 37
WWW_DIR ?= www/default
WWW_DIRS := www/default
# Microsoft Entra tenant for `auth=saml`; no default, pass AZURE_TENANT=<tenant-guid>.
AZURE_TENANT ?=
RUST_LOG ?= debug
# Hex backup encryption key (32 bytes). Required at runtime; defaults to the file
# generated by `config-certs` (envs/backup_encryption_key) so local backups/restores
# work out of the box. Override via env or `make run-debug AS_BACKUP_ENCRYPTION_KEY=$$(openssl rand -hex 32)`.
AS_BACKUP_KEY_FILE ?= envs/backup_encryption_key
AS_BACKUP_ENCRYPTION_KEY ?= $(or $(AGENT_STREAM_BACKUP_ENCRYPTION_KEY),$(shell cat $(AS_BACKUP_KEY_FILE) 2>/dev/null))
# Hex master key (32 bytes) for encryption at rest. The generated config.toml enables
# encryption with key_source = "environment"; defaults to the file generated by
# `config-certs` (envs/master_key).
AS_MASTER_KEY_FILE ?= envs/master_key
AS_MASTER_KEY ?= $(or $(AGENT_STREAM_MASTER_KEY),$(shell cat $(AS_MASTER_KEY_FILE) 2>/dev/null))
export AS_MASTER_KEY
LLVM_COV ?= $(if $(RUST_LLVM_PREFIX),$(RUST_LLVM_PREFIX)/bin/llvm-cov,$(shell command -v llvm-cov 2>/dev/null))
LLVM_PROFDATA ?= $(if $(RUST_LLVM_PREFIX),$(RUST_LLVM_PREFIX)/bin/llvm-profdata,$(shell command -v llvm-profdata 2>/dev/null))
LLVM_COV_ENV := $(if $(LLVM_COV),LLVM_COV="$(LLVM_COV)") $(if $(LLVM_PROFDATA),LLVM_PROFDATA="$(LLVM_PROFDATA)")
COVERAGE_PROFILE_ARTIFACTS := target/llvm-cov-target/*.profraw target/llvm-cov-target/*-profraw-list target/llvm-cov-target/*.profdata
AS_TEST_MODE := true
AS_TEST_TOKEN := testkit-secret-token
AS_TEST_ENV := AS_TEST_MODE=$(AS_TEST_MODE) AS_TEST_TOKEN=$(AS_TEST_TOKEN)
# Default appliance URL when no x= and no h= are supplied.
TESTKIT_HOST ?= http://localhost:8080

# ==============================================================================
# Help
# ==============================================================================

help: ## Show this help message
	@echo ""
	@echo "$(BLUE)Agent Stream - Available Commands$(NC)"
	@echo "=============================================="
	@echo ""
	@awk 'BEGIN {FS = ":.*##"} /^[a-zA-Z0-9_-]+:.*##/ { printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2 }' $(MAKEFILE_LIST)
	@echo ""

# ==============================================================================
# Setup Commands
# ==============================================================================

install-rust-deps: ## Install Rust build toolchain dependencies (sccache, lld, etc.)
	@echo "$(BLUE)📦 Installing Rust build dependencies...$(NC)"
	@brew install $(RUST_DEPS) 2>/dev/null || true
	@rustup component add llvm-tools-preview
	@for tool in $(CARGO_TOOLS); do cargo install $$tool --locked; done
	@echo "$(GREEN)✅ Rust dependencies installed!$(NC)"

verify-rust-deps: ## Verify Rust build toolchain dependencies (sccache, lld, etc.)
	@echo "$(BLUE)📦 Verifying Rust build dependencies...$(NC)"
	@brew ls --version $(RUST_DEPS) 2>/dev/null || (echo "$(RED)❌ Rust dependencies are not installed. Please run 'make install-rust-deps' to install them.$(NC)" && exit 1)
	@for tool in $(CARGO_TOOLS); do \
		command -v $$tool >/dev/null 2>&1 || (echo "$(RED)❌ $$tool not found. Please run 'make install-rust-deps' to install it.$(NC)" && exit 1); \
	done
	@rustup component list --installed 2>/dev/null | grep -q llvm-tools || (echo "$(RED)❌ llvm-tools-preview not installed. Please run 'make install-rust-deps'.$(NC)" && exit 1)
	@$(MAKE) --no-print-directory verify-xml-libs
	@echo "$(GREEN)✅ Rust dependencies verified!$(NC)"

verify-xml-libs: ## Verify libxml2/libxslt/libxmlsec1 resolve to a single Homebrew copy
	@echo "$(BLUE)🔍 Verifying XML library linkage...$(NC)"
	@if [ "$$(uname -s)" != "Darwin" ]; then \
		echo "$(GREEN)✅ Not macOS; system packages provide a single libxml2.$(NC)"; \
		exit 0; \
	fi
	@if [ -z "$(BREW_PREFIX)" ]; then \
		echo "$(RED)❌ Homebrew not found; cannot verify XML library linkage.$(NC)"; exit 1; \
	fi
	@for pc in libxml-2.0 libxslt xmlsec1-openssl; do \
		libdir=$$(PKG_CONFIG_PATH="$(XML_PKG_CONFIG_PATH)" pkg-config --variable=libdir $$pc 2>/dev/null); \
		if [ -z "$$libdir" ]; then \
			echo "$(RED)❌ pkg-config cannot find $$pc. Run 'make install-rust-deps'.$(NC)"; exit 1; \
		fi; \
		case "$$libdir" in \
			$(BREW_PREFIX)/*) ;; \
			*) echo "$(RED)❌ $$pc resolves to $$libdir, outside $(BREW_PREFIX). Fix PKG_CONFIG_PATH.$(NC)"; exit 1;; \
		esac; \
	done
	@bin=; \
	for b in target/debug/agent-stream target/release/agent-stream; do \
		if [ -x "$$b" ] && { [ -z "$$bin" ] || [ "$$b" -nt "$$bin" ]; }; then bin=$$b; fi; \
	done; \
	if [ -z "$$bin" ]; then echo "$(YELLOW)⚠️  No agent-stream build yet, libxml2/libxslt link check skipped$(NC)"; exit 0; fi; \
	for lib in libxml2 libxslt; do \
		paths=$$(otool -L "$$bin" | awk -v lib="/$$lib." 'index($$1, lib) { print $$1 }'); \
		count=$$(printf '%s' "$$paths" | grep -c .); \
		if [ "$$count" -eq 0 ]; then echo "$(RED)❌ $$bin does not link $$lib$(NC)"; exit 1; fi; \
		if [ "$$count" -ne 1 ]; then \
			echo "$(RED)❌ $$bin links $$count copies of $$lib:$(NC)"; printf '%s\n' "$$paths"; \
			echo "$(RED)   Run 'make fix-xml-libs'.$(NC)"; exit 1; \
		fi; \
		path=$$paths; \
		case "$$path" in \
			$(BREW_PREFIX)/*) ;; \
			*) echo "$(RED)❌ $$bin links $$path, not Homebrew's $$lib. Run 'make fix-xml-libs'.$(NC)"; exit 1;; \
		esac; \
		if [ ! -e "$$path" ]; then echo "$(RED)❌ $$bin links $$path, which no longer exists (brew upgraded $$lib). Run 'make fix-xml-libs'.$(NC)"; exit 1; fi; \
		echo "  $$lib: $$path"; \
	done
	@echo "$(GREEN)✅ XML libraries resolve to a single Homebrew copy.$(NC)"

# Rebuilds only the crates that link the XML libraries (and so the binary), not
# the whole target dir. No verify-rust-deps first: its link check would fail on
# the very binary this target replaces.
fix-xml-libs: ## (macOS) Relink against Homebrew's libxml2/libxslt/libxmlsec1 after a wrong link or a brew upgrade
	@echo "$(BLUE)🔧 Relinking the XML libraries...$(NC)"
	@cargo clean -p libxml -p samael -p sasl2-sys
	@cargo build
	@$(MAKE) --no-print-directory verify-xml-libs

install-git-hooks: ## Install git hooks via pre-commit framework
	@echo "$(BLUE)🔗 Installing git hooks...$(NC)"
	@pre-commit install
	@echo "$(GREEN)✅ Git hooks installed!$(NC)"

install-deps: install-rust-deps ## Install all local development dependencies (macOS)
	@echo "$(BLUE)📦 Installing dependencies...$(NC)"
	@brew install $(DEPS) 2>/dev/null || true
	@$(MAKE) install-git-hooks
	@echo "$(GREEN)✅ Dependencies installed!$(NC)"

# ==============================================================================
# Build Commands
# ==============================================================================

cargo-build: verify-rust-deps ## Build the debug binary
	@echo "$(BLUE)📦 Building debug binary...$(NC)"
	@cargo build
	@$(MAKE) --no-print-directory verify-xml-libs
	@echo "$(GREEN)✅ Debug build completed!$(NC)"

cargo-build-ci: ## Build all Rust targets/features like CI
	@echo "$(BLUE)📦 Building all Rust targets and features...$(NC)"
	@cargo build --all-targets --all-features
	@echo "$(GREEN)✅ CI-equivalent Rust build completed!$(NC)"

cargo-release: verify-rust-deps ## Build the release binary
	@echo "$(BLUE)📦 Building release binary...$(NC)"
	@cargo build --release
	@$(MAKE) --no-print-directory verify-xml-libs
	@echo "$(GREEN)✅ Release build completed!$(NC)"

npm-install: ## Install frontend npm dependencies
	@echo "$(BLUE)📦 Installing npm dependencies...$(NC)"
	@cd $(WWW_DIR) && npm install
	@echo "$(GREEN)✅ npm install completed!$(NC)"

npm-install-ci: ## Install frontend npm dependencies (npm ci)
	@echo "$(BLUE)📦 Installing npm dependencies with npm ci...$(NC)"
	@cd $(WWW_DIR) && npm ci
	@echo "$(GREEN)✅ npm ci completed!$(NC)"

www: ## Build the frontend app
	@echo "$(BLUE)📦 Building frontend app...$(NC)"
	@./$(WWW_DIR)/build.sh
	@echo "$(GREEN)✅ Dashboard build completed!$(NC)"

www-rebuild: ## Delete $(WWW_DIR)/build, rebuild UI, and refresh local env config
	@echo "$(BLUE)🗑️  Removing $(WWW_DIR)/build...$(NC)"
	@rm -rf $(WWW_DIR)/build
	@echo "$(BLUE)📦 Rebuilding frontend app...$(NC)"
	@./$(WWW_DIR)/build.sh
	@echo "$(BLUE)🔧 Refreshing local env config with new build path...$(NC)"
	@./scripts/_prepare.sh debug envs/local
	@echo "$(GREEN)✅ UI rebuilt and local env updated!$(NC)"

# ==============================================================================
# Config Commands
# ==============================================================================

config-certs: ## Prepare TLS certificates, backup encryption key and encryption-at-rest master key for local development
	@echo "$(BLUE)🔐 Setting up TLS certificates...$(NC)"
	@./scripts/_certs.sh
	@echo "$(GREEN)✅ TLS certificates ready!$(NC)"

config-debug: config-certs www ## Full debug environment setup (deps + build + config)
	@echo "$(BLUE)🔧 Configuring debug environment...$(NC)"
	@./scripts/_prepare.sh debug envs/local
	@echo "$(GREEN)✅ Debug environment ready!$(NC)"

config-debug-dev: config-certs ## Debug environment setup without static frontend build (for dev server)
	@echo "$(BLUE)🔧 Configuring debug environment (dev mode)...$(NC)"
	@./scripts/_prepare.sh debug envs/local
	@echo "$(GREEN)✅ Debug dev environment ready!$(NC)"

config-debug-x: config-certs www ## Debug setup for a specific instance (x=1, x=my-tests, etc.)
	@echo "$(BLUE)🔧 Configuring debug instance $(or $(x),1)...$(NC)"
	@./scripts/_prepare.sh debug envs/local-$(or $(x),1)
	@echo "$(GREEN)✅ Debug instance $(or $(x),1) ready!$(NC)"

config-release: config-certs www cargo-release ## Full release environment setup (deps + build + config)
	@echo "$(BLUE)🔧 Configuring release environment...$(NC)"
	@./scripts/_prepare.sh release envs/local
	@echo "$(GREEN)✅ Release environment ready!$(NC)"

config-docker: config-certs .docker-local ## Docker environment setup (envs/docker); builds the image first
	@echo "$(BLUE)🔧 Configuring Docker environment...$(NC)"
	@./scripts/_prepare.sh docker envs/docker
	@echo "$(GREEN)✅ Docker environment ready!$(NC)"

config-test: config-certs ## Configure isolated test environment (envs/local-tests)
	@echo "$(BLUE)🔧 Configuring test environment...$(NC)"
	@echo "$(GREEN)✅ Test environment ready!$(NC)"

# ==============================================================================
# Run Commands
# ==============================================================================

run-debug: config-certs ## Run in debug mode; x=name for named instance; o=1 forces browser reopen; auth=saml enables SAML (requires AZURE_TENANT=<tenant-guid>); tk=1 enables test-auth (AS_TEST_MODE/TOKEN) (builds www + cargo)
	@$(MAKE) www
	@cargo build
	@[ -n "$(o)" ] && rm -f "envs/local$(if $(x),-$(x),)/.browser_opened" || true
	@if [ -n "$(x)" ]; then \
		echo "$(BLUE)🔧 Configuring debug instance $(x)...$(NC)"; \
		./scripts/_prepare.sh debug envs/local-$(x); \
		echo "$(GREEN)✅ Debug instance $(x) ready!$(NC)"; \
	else \
		echo "$(BLUE)🔧 Configuring debug environment (dev mode)...$(NC)"; \
		./scripts/_prepare.sh debug envs/local; \
		echo "$(GREEN)✅ Debug dev environment ready!$(NC)"; \
	fi
	@if [ "$(auth)" = "saml" ]; then ./scripts/_saml-setup.sh "envs/local$(if $(x),-$(x),)" "$(AZURE_TENANT)"; fi
	@[ "$(auth)" = "passkey" ] && ./scripts/_passkey-setup.sh "envs/local$(if $(x),-$(x),)" || true
	@if [ -n "$(x)" ]; then \
		RUST_LOG="$(RUST_LOG)" AS_BACKUP_ENCRYPTION_KEY="$(AS_BACKUP_ENCRYPTION_KEY)"$(if $(filter 1,$(tk)), $(AS_TEST_ENV),) ./scripts/l-run-debug.sh $(x); \
	else \
		RUST_LOG="$(RUST_LOG)" AS_BACKUP_ENCRYPTION_KEY="$(AS_BACKUP_ENCRYPTION_KEY)"$(if $(filter 1,$(tk)), $(AS_TEST_ENV),) ./scripts/l-run-debug.sh; \
	fi

run-watch: config-certs ## Run with cargo watch (auto-rebuild/restart on Rust changes); x=name for named instance; o=1 forces browser reopen; auth=saml enables SAML (requires AZURE_TENANT=<tenant-guid>); tk=1 enables test-auth
	@command -v cargo-watch >/dev/null 2>&1 || (echo "$(RED)❌ cargo-watch is not installed. Run: make install-rust-deps$(NC)" && exit 1)
	@$(MAKE) www
	@[ -n "$(o)" ] && rm -f "envs/local$(if $(x),-$(x),)/.browser_opened" || true
	@if [ -n "$(x)" ]; then \
		echo "$(BLUE)🔧 Configuring watch instance $(x)...$(NC)"; \
		./scripts/_prepare.sh debug envs/local-$(x); \
		echo "$(GREEN)✅ Watch instance $(x) ready!$(NC)"; \
	else \
		echo "$(BLUE)🔧 Configuring watch environment (dev mode)...$(NC)"; \
		./scripts/_prepare.sh debug envs/local; \
		echo "$(GREEN)✅ Watch dev environment ready!$(NC)"; \
	fi
	@if [ "$(auth)" = "saml" ]; then ./scripts/_saml-setup.sh "envs/local$(if $(x),-$(x),)" "$(AZURE_TENANT)"; fi
	@[ "$(auth)" = "passkey" ] && ./scripts/_passkey-setup.sh "envs/local$(if $(x),-$(x),)" || true
	@if [ -n "$(x)" ]; then \
		RUST_LOG="$(RUST_LOG)" AS_BACKUP_ENCRYPTION_KEY="$(AS_BACKUP_ENCRYPTION_KEY)"$(if $(filter 1,$(tk)), $(AS_TEST_ENV),) ./scripts/l-run-watch.sh $(x); \
	else \
		RUST_LOG="$(RUST_LOG)" AS_BACKUP_ENCRYPTION_KEY="$(AS_BACKUP_ENCRYPTION_KEY)"$(if $(filter 1,$(tk)), $(AS_TEST_ENV),) ./scripts/l-run-watch.sh; \
	fi

run-release: config-release ## Run locally (release mode); tk=1 enables test-auth
	@RUST_LOG="$(RUST_LOG)" AS_BACKUP_ENCRYPTION_KEY="$(AS_BACKUP_ENCRYPTION_KEY)"$(if $(filter 1,$(tk)), $(AS_TEST_ENV),) ./scripts/l-run-release.sh

www-dev: www ## Run the frontend app in development mode
	@echo "$(BLUE)🚀 Starting frontend dev server...$(NC)"
	@cd $(WWW_DIR) && npm start

# ==============================================================================
# Docker Commands
# ==============================================================================

.docker-local: Cargo.toml Cargo.lock Dockerfile $(shell find src -name '*.rs' 2>/dev/null)
	@echo "$(BLUE)🐳 Building Docker image locally...$(NC)"
	@./scripts/d-build.sh --name agent-stream --folder . --version local --dockerfile Dockerfile
	@touch $@
	@echo "$(GREEN)✅ Docker image built!$(NC)"

.docker-local-dev: Cargo.toml Cargo.lock Dockerfile.dev $(shell find src -name '*.rs' 2>/dev/null)
	@echo "$(BLUE)🐳 Building Docker dev image locally...$(NC)"
	@./scripts/d-build.sh --name agent-stream --folder . --version local-dev --dockerfile Dockerfile.dev
	@touch $@
	@echo "$(GREEN)✅ Docker dev image built!$(NC)"

docker-build-local: .docker-local ## Build Docker image locally (Dockerfile); skips if up-to-date

docker-build-local-dev: .docker-local-dev ## Build Docker dev image locally (Dockerfile.dev); skips if up-to-date

docker-rebuild-local: ## Force rebuild Docker image (Dockerfile)
	@rm -f .docker-local
	@$(MAKE) .docker-local

docker-rebuild-local-dev: ## Force rebuild Docker dev image (Dockerfile.dev)
	@rm -f .docker-local-dev
	@$(MAKE) .docker-local-dev

docker-run: config-docker ## Run in Docker (auto-rebuilds if sources changed)
	@./scripts/d-run.sh

docker-run-dev: config-certs .docker-local-dev ## Run in Docker dev mode (debug build, faster; auto-rebuilds if sources changed)
	@TAG=agent-stream:local-dev ./scripts/_prepare.sh docker envs/docker
	@TAG=agent-stream:local-dev ./scripts/d-run.sh

docker-shell: ## Shell into a Docker container for debugging
	@./scripts/d-shell.sh

docker-network: ## Create the Docker network (agent-network)
	@docker network create agent-network 2>/dev/null || echo "Network agent-network already exists."

# Run a cargo test command and always clean up www/src/generated afterward
# (the ts-rs export macros write files there during every test compilation).
# Usage: $(call rust_test,cargo test --lib)
define rust_test
@set +e; $(1); STATUS=$$?; rm -rf www/src/generated; exit $$STATUS
endef

# ==============================================================================
# Testing Commands
# ==============================================================================

test-all: test npm-test ui-test ## Run all tests (Rust + npm + UI)
	@echo "$(GREEN)✅ All tests completed!$(NC)"

test: config-test ## Run all Rust tests (use test=name to filter)
	@echo "$(BLUE)🧪 Running tests...$(NC)"
ifdef test
	$(call rust_test,cargo test --no-fail-fast --all-targets --all-features -- $(test))
else
	$(call rust_test,cargo test --no-fail-fast --all-targets --all-features)
endif
	@echo "$(GREEN)✅ Tests completed!$(NC)"

test-unit: config-test ## Run unit tests only
	@echo "$(BLUE)🧪 Running unit tests...$(NC)"
	$(call rust_test,cargo test --lib)
	@echo "$(GREEN)✅ Unit tests completed!$(NC)"

test-bins: config-test ## Run binary tests only
	@echo "$(BLUE)🧪 Running binary tests...$(NC)"
	$(call rust_test,cargo test --bins)
	@echo "$(GREEN)✅ Binary tests completed!$(NC)"

test-integration: ## Run the end-to-end testkit (self-hosted appliance via docker-compose)
	@echo "$(BLUE)🧪 Running integration tests...$(NC)"
	@cd tests/appliance && ./run.sh managed
	@echo "$(GREEN)✅ Integration tests completed!$(NC)"

test-policies: config-test ## Run policy engine tests
	@echo "$(BLUE)🧪 Running policy tests...$(NC)"
	@cargo test --package agent-stream --lib policies::opa::tests
	@echo "$(GREEN)✅ Policy tests completed!$(NC)"

test-junit: config-test ## Run tests with nextest and emit JUnit XML (test-results.xml)
	@echo "$(BLUE)🧪 Running tests with JUnit output...$(NC)"
	$(call rust_test,cargo nextest run --no-fail-fast --all-features --profile ci)
	@echo "$(GREEN)✅ JUnit report written to test-results.xml$(NC)"

test-rust-ci: config-test ## Run the CI Rust test flow locally (coverage + surface BDD)
	@echo "$(BLUE)🧪 Running CI Rust test flow...$(NC)"
	@rm -f coverage.xml surface_bdd_test.log $(COVERAGE_PROFILE_ARTIFACTS)
	@set +e; $(LLVM_COV_ENV) cargo llvm-cov nextest --no-clean --no-fail-fast --all-features -P ci --cobertura --output-path coverage.xml --fail-under-lines $(COVERAGE_THRESHOLD) 2>&1 | tee test.log; STATUS=$${PIPESTATUS[0]}; \
	  cp target/llvm-cov-target/nextest/ci/test-results.xml test-results.xml 2>/dev/null || cp target/nextest/ci/test-results.xml test-results.xml 2>/dev/null || true; \
	  if [[ -s coverage.xml ]]; then COV=$$(grep -m1 'line-rate=' coverage.xml | sed 's/.*line-rate="\([0-9.]*\)".*/\1/' | awk '{printf "%.2f%%", $$1*100}'); fi; \
	  echo "$(BLUE)📊 Lines coverage: $${COV:-0.00%}$(NC)"; \
	  BDD_MAX_CONCURRENT_SCENARIOS=$${BDD_MAX_CONCURRENT_SCENARIOS:-1} $(LLVM_COV_ENV) cargo llvm-cov test --no-clean --test surface_bdd 2>&1 | tee surface_bdd_test.log; BDD_STATUS=$${PIPESTATUS[0]}; \
	  echo "cargo llvm-cov test --test surface_bdd exit status: $${BDD_STATUS}"; \
	  if [[ $$STATUS -ne 0 || $$BDD_STATUS -ne 0 ]]; then echo "$(RED)❌ Test failures: unit/integration=$$STATUS bdd=$$BDD_STATUS$(NC)"; exit 1; fi
	@echo "$(GREEN)✅ CI Rust test flow passed!$(NC)"

lint-bdd-gherkin: ## Run BDD/Gherkin inventory lint like CI
	@echo "$(BLUE)📎 Running BDD/Gherkin lint...$(NC)"
	@python3 -m py_compile scripts/bdd-gherkin.py
	@scripts/bdd-gherkin.py --self-test
	@scripts/bdd-gherkin.py --lint
	@echo "$(GREEN)✅ BDD/Gherkin lint passed!$(NC)"

test-bdd: config-test ## Run executable surface BDD scenarios
	@echo "$(BLUE)🧪 Running surface BDD scenarios...$(NC)"
	@BDD_MAX_CONCURRENT_SCENARIOS=$${BDD_MAX_CONCURRENT_SCENARIOS:-1} cargo test --test surface_bdd
	@echo "$(GREEN)✅ Surface BDD scenarios passed!$(NC)"

test-coverage: config-test ## Run tests with coverage + JUnit report (mirrors CI; outputs coverage.xml + test-results.xml)
	@echo "$(BLUE)🧪 Running tests with coverage...$(NC)"
	@rm -f coverage.xml $(COVERAGE_PROFILE_ARTIFACTS)
	@set +e; $(LLVM_COV_ENV) cargo llvm-cov nextest --no-clean --no-fail-fast --all-features -P ci --cobertura --output-path coverage.xml --fail-under-lines $(COVERAGE_THRESHOLD) 2>&1 | tee test.log; STATUS=$${PIPESTATUS[0]}; \
	  cp target/llvm-cov-target/nextest/ci/test-results.xml test-results.xml 2>/dev/null || cp target/nextest/ci/test-results.xml test-results.xml 2>/dev/null || true; \
	  COV=$$(grep -m1 'line-rate=' coverage.xml | sed 's/.*line-rate="\([0-9.]*\)".*/\1/' | awk '{printf "%.2f%%", $$1*100}'); echo "$(BLUE)📊 Lines coverage: $${COV}$(NC)"; \
	  rm -rf www/src/generated; \
	  exit $$STATUS
	@echo "$(GREEN)✅ Coverage completed! JUnit report written to test-results.xml$(NC)"

