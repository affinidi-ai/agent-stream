CLIENT_DIR := clients/vscode-agent-stream
CLIENT_VERSIONS_DIR := clients/vscode-agent-stream/versions

make-client: ## Build the VS Code extension .vsix and copy it to clients/versions/
	@echo "$(BLUE)📦 Building VS Code extension...$(NC)"
	@cd $(CLIENT_DIR) && npm install --silent
	@cd $(CLIENT_DIR) && npm run package
	@mkdir -p $(CLIENT_VERSIONS_DIR)
	@VERSION=$$(node -p "require('./$(CLIENT_DIR)/package.json').version"); \
	  cp $(CLIENT_DIR)/agent-stream-vscode.vsix $(CLIENT_VERSIONS_DIR)/agent-stream-vscode-$${VERSION}.vsix; \
	  rm -f $(CLIENT_DIR)/agent-stream-vscode.vsix; \
	  echo "$(GREEN)✅ VS Code extension built: $(CLIENT_VERSIONS_DIR)/agent-stream-vscode-$${VERSION}.vsix$(NC)"
