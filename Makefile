# --- Local targets: autofix, for development workflow ---

node-local: ## Run frontend checks locally with autofix (fmt + lint --fix + build + test)
	@$(MAKE) npm-install
	@$(MAKE) npm-lint
	@$(MAKE) npm-build
	@$(MAKE) npm-test
	@echo "$(GREEN)✅ Local frontend checks passed!$(NC)"

rust-local: ## Run Rust checks locally with autofix (fmt + clippy --fix + audit + build + test)
	@$(MAKE) fmt
	@$(MAKE) check
	@$(MAKE) clippy
	@$(MAKE) audit
	@$(MAKE) cargo-build
	@$(MAKE) test
	@echo "$(GREEN)✅ Local Rust checks passed!$(NC)"

# When this make started, for the run's total on local's last line.
LOCAL_STARTED := $(shell date +%s)

# `make local`: formatting first, alone, since everything after it reads the
# files it rewrites. Then the checks as groups side by side, then the tests
# (scripts/local/parallel.sh; each run's logs and summary in
# tmp/local/<date>_<time>/, tmp/local/latest the newest). The frontend and
# backend groups touch different folders, so nothing writes what another reads;
# `audit` runs `npm audit` in the dashboard folder, so it follows `node-local`'s
# `npm install` in the frontend group. No `make check`: clippy compiles
# everything it would, and more. PARALLEL=0 runs every group one after another,
# for a machine short of memory.
PARALLEL ?= 1
LOCAL_CHECKS := "frontend=node-local audit" "backend=clippy cargo-build"
LOCAL_TESTS := "backend-tests=test"
local: ## Run all local checks with autofix: fmt, then the frontend and backend checks side by side, then the tests (PARALLEL=0: one at a time); ends with the time taken
	@$(MAKE) fmt
	@MAKE="$(MAKE)" PARALLEL=$(PARALLEL) bash scripts/local/parallel.sh "Checks" $(LOCAL_CHECKS)
	@MAKE="$(MAKE)" PARALLEL=$(PARALLEL) bash scripts/local/parallel.sh "Tests" $(LOCAL_TESTS)
	@secs=$$(( $$(date +%s) - $(LOCAL_STARTED) )); \
	  echo "$(GREEN)✅ All local checks passed in $$((secs / 60))m $$((secs % 60))s.$(NC)"

# Fail if any tracked files were modified by an autofix step.
# Call this after all fmt/fix passes so the error lists all changed files at once.
define check_no_diff
	if ! git --no-pager diff --quiet; then \
		echo "$(RED)❌ Autofix changed files. Stage and commit them, then re-push:$(NC)"; \
		git --no-pager diff --name-only; \
		exit 1; \
	fi
endef

pre-commit-rust: ## Run Rust pre-push checks (fmt + clippy autofix) — fails if any file was changed; tests run in CI
	@echo "$(BLUE)🦀 Running Rust pre-push checks...$(NC)"
	@cargo fmt --all
	@cargo clippy --all-targets --all-features --fix --allow-dirty -- -D warnings
	@$(check_no_diff)
	@echo "$(GREEN)✅ Rust pre-push checks passed!$(NC)"

pre-commit-rust-test: ## Run Rust test suite (pre-push)
	@echo "$(BLUE)🧪 Running Rust tests...$(NC)"
	$(call rust_test,cargo test --no-fail-fast --all-targets --all-features)
	@echo "$(GREEN)✅ Rust tests passed!$(NC)"

pre-commit-node: ## Run Node pre-push checks (fmt + lint autofix) — fails if any file was changed
	@echo "$(BLUE)📦 Running Node pre-push checks...$(NC)"
	@cd $(WWW_DIR) && npm run format --if-present
	@cd $(WWW_DIR) && npm run lint:fix
	@$(check_no_diff)
	@echo "$(GREEN)✅ Node pre-push checks passed!$(NC)"

pre-commit: pre-commit-rust pre-commit-node ## Run all pre-push checks (fmt + autofix) — fails if any file was changed; tests run in CI
	@$(check_no_diff)
	@echo "$(GREEN)✅ Pre-commit checks passed!$(NC)"

