# ==============================================================================
# Testkit Commands (external-mode — drives a running appliance)
# Host selection (all testkit-* targets):
#
#   x=<name>   source envs/local-{name}/instance.env (must exist);
#              h=l → $URL_LOCAL from that file
#              h=p → $URL_PROXY from that file
#
#   no x       h=<url> → use h directly as the appliance URL
#              no h    → TESTKIT_HOST Makefile default (http://localhost:8080)
#
#   Override default: make testkit-smoke TESTKIT_HOST=http://localhost:9100
# ==============================================================================

# Resolve appliance host. Returns empty on error (guarded in every recipe).
define _testkit_host
$(if $(x),$(shell \
  env="envs/local-$(x)/instance.env"; \
  cfg="envs/local-$(x)/config/agent-stream.json"; \
  if [ ! -f "$$env" ]; then \
    echo "ERROR: $$env not found" >&2; \
  elif [ "$(h)" = "p" ]; then \
    . "$$env"; \
    proxy="$$URL_PROXY"; \
    if [ -z "$$proxy" ] && [ -f "$$cfg" ]; then \
      domain=$$(jq -r '.domain // empty' "$$cfg" 2>/dev/null); \
      [ -n "$$domain" ] && proxy="https://$$domain"; \
    fi; \
    echo "$$proxy"; \
  else \
    . "$$env"; echo "$$URL_LOCAL"; \
  fi),$(if $(h),$(h),$(TESTKIT_HOST)))
endef

# Fail early when the resolved host is empty.
define _testkit_guard
@[ -n "$(_HOST)" ] || { echo "$(RED)❌ Cannot resolve host — check x=$(x) has instance.env, h=l|p is set, or pass h=<url>.$(NC)"; exit 1; }
endef

testkit-smoke: ## Smoke test ~1 min: small load, no drills, one round (x=<name> h=p|<url>)
	$(eval _HOST := $(call _testkit_host))
	$(call _testkit_guard)
	@echo "$(BLUE)🧪 Smoke test against $(_HOST)…$(NC)"
	@cd tests/appliance && ./run.sh external -host $(_HOST) -load small -requests 30 -no-cap-drill -no-rejection-drill -no-interactive
	@echo "$(GREEN)✅ Smoke test passed!$(NC)"

testkit: ## Standard integration test: small load + all drills, one round (x=<name> h=p|<url>)
	$(eval _HOST := $(call _testkit_host))
	$(call _testkit_guard)
	@echo "$(BLUE)🧪 Integration test against $(_HOST)…$(NC)"
	@cd tests/appliance && ./run.sh external -host $(_HOST) -load small -no-interactive
	@echo "$(GREEN)✅ Integration test passed!$(NC)"

testkit-full: ## Full integration test: medium load + all drills, interactive loop (x=<name> h=p|<url>)
	$(eval _HOST := $(call _testkit_host))
	$(call _testkit_guard)
	@echo "$(BLUE)🧪 Full integration test against $(_HOST)…$(NC)"
	@cd tests/appliance && ./run.sh external -host $(_HOST) -load medium
	@echo "$(GREEN)✅ Full integration test passed!$(NC)"

testkit-load: ## Load test: large traffic, no drills, one round (x=<name> h=p|<url>)
	$(eval _HOST := $(call _testkit_host))
	$(call _testkit_guard)
	@echo "$(BLUE)🧪 Load test against $(_HOST)…$(NC)"
	@cd tests/appliance && ./run.sh external -host $(_HOST) -load large -no-cap-drill -no-rejection-drill -no-interactive
	@echo "$(GREEN)✅ Load test passed!$(NC)"

